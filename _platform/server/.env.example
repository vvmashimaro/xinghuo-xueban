# 星火学伴 · API 环境变量配置示例
# 复制为 .env 并填入实际值（.env 已列入 .gitignore，不会提交）

# ========== 基础服务配置 ==========
HOST=127.0.0.1
PORT=8787
NODE_ENV=development
# NODE_ENV=production 时启用生产安全规则

# 数据库路径（JSON 文件）
DATABASE_PATH=./data/db.json

# ========== CORS 跨域配置 ==========
# 逗号分隔的允许来源，生产环境必填
# 例如：https://vvmashimaro.github.io,https://your-custom-domain.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ========== 管理员配置 ==========
# 管理员手机号白名单（逗号分隔），这些手机号登录后拥有管理员权限
# 例如：13800138000,13900139000
ADMIN_PHONES=

# 管理员令牌（备用，用于 API 直接调用危险接口）
# 生产环境下，重置/快照替换等危险接口需要此令牌或管理员登录
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=

# ========== 短信服务配置 ==========
# 短信提供商：mock（开发/演示）、tencent（腾讯云）
SMS_PROVIDER=mock

# TEMPORARY / DEV ONLY — 万能短信验证码（登录/注册/绑定/小程序共用 API 校验）
# 开启后非管理员手机号可使用 DEV_OTP_CODE 通过校验（仍接受真实下发的验证码）
# NODE_ENV=production 时：管理员账号严禁使用万能码（即使 ALLOW_DEV_OTP=true）
# 真实短信上线后请关闭。当前生产过渡期可保持 ALLOW_DEV_OTP=true 供非管理员使用。
# ALLOW_DEV_OTP=true
# DEV_OTP_CODE=888888
# 同一 IP 每小时短信发送上限（生产环境生效；设为 0 关闭）
# SMS_MAX_IP_HOURLY=30

# 生产环境允许 POST /api/reset 与 POST /api/snapshot 覆盖数据库（默认禁止）
# ALLOW_DANGEROUS_DB_RESET=true

# 腾讯云短信（SMS_PROVIDER=tencent 时需要）
# 使用腾讯云 SMS API SendSms (version 2021-01-11, TC3-HMAC-SHA256 签名)
TENCENT_SMS_SECRET_ID=
TENCENT_SMS_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=星火学伴
TENCENT_SMS_REGION=ap-guangzhou
# 登录验证码模板（验证码类，支持变量；参数：验证码、有效期分钟数）
# 控制台示例：【星火学伴】验证码{1}，{2}分钟内有效，请勿泄露。
TENCENT_SMS_TEMPLATE_LOGIN=
# 以下为「通知短信」固定全文模板（不支持变量，代码不传 TemplateParamSet）
# 新约课待接单 → 导师
# 固定文案：您有新的约课待接单，请登录星火学伴导师端查看详情。
TENCENT_SMS_TEMPLATE_BOOKING=
# 导师接单 → 家长（未配置时回退 TENCENT_SMS_TEMPLATE_BOOKING）
# 固定文案：导师已确认您的约课，请登录星火学伴查看上课时间与地点。
TENCENT_SMS_TEMPLATE_ACCEPT=
# 导师接单确认 → 导师本人（需 SMS_NOTIFY_MENTOR_ON_ACCEPT=true）
# 固定文案：您已确认本次约课，请登录星火学伴导师端查看详情。
TENCENT_SMS_TEMPLATE_ACCEPT_MENTOR=
# 导师拒单 → 家长
# 固定文案：抱歉，导师暂无法承接本次约课，请登录星火学伴重新选择导师。
TENCENT_SMS_TEMPLATE_CANCEL=
# 家长撤销 → 导师（未配置时回退 TENCENT_SMS_TEMPLATE_CANCEL）
# 固定文案：家长已撤销约课，请登录星火学伴查看。
TENCENT_SMS_TEMPLATE_CANCEL_MENTOR=
# 家长撤销退款 → 家长
# 固定文案：您的约课已撤销，退款将原路退回微信，请留意到账通知。
TENCENT_SMS_TEMPLATE_REFUND=
# 导师接单时是否同时短信通知导师（true/false，默认 false）
SMS_NOTIFY_MENTOR_ON_ACCEPT=false

# ========== 微信小程序配置 ==========
# 微信小程序 AppID 和 AppSecret（用于手机号授权）
# 星火伴学o2o AppID: wx5a978366a03285cb
WECHAT_APP_ID=wx5a978366a03285cb
WECHAT_APP_SECRET=
# 微信手机号授权模式：mock（开发/演示）、production（生产）
WX_PHONE_MODE=mock
# 微信小程序 jscode2session（获取 openid）：mock / production（默认跟随 WX_PHONE_MODE）
WX_SESSION_MODE=mock

# ========== 手机号加密配置 ==========
# 手机号加密密钥（至少32位随机字符串，生产环境必填）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PHONE_ENCRYPTION_KEY=

# ========== 微信支付配置 ==========
# 微信支付商户信息
WECHAT_MCH_ID=
WECHAT_APP_ID=wx5a978366a03285cb
WECHAT_API_V3_KEY=
WECHAT_MCH_SERIAL_NO=
# 商户私钥 PEM 文件路径（相对或绝对路径）
WECHAT_PRIVATE_KEY_PATH=./keys/wechat_private_key.pem
# 或直接填入 PEM 内容（用 \n 表示换行）
WECHAT_PRIVATE_KEY_PEM=

# 微信支付回调通知 URL（须公网 HTTPS，如 https://your-api.com/api/pay/wechat/notify）
WECHAT_NOTIFY_URL=

# 允许模拟支付（仅开发环境，生产环境即使设置也会被忽略）
ALLOW_MOCK_PAY=true

# ========== API 公开 URL ==========
# API 对外访问地址，供前端与小程序调用
# 例如：https://your-api.render.com 或 https://api.xinghuo-xueban.com
API_PUBLIC_URL=http://127.0.0.1:8787

# ========== 其他占位（按需扩展） ==========
# LOG_LEVEL=info
# REDIS_URL=
# MONITORING_WEBHOOK=
