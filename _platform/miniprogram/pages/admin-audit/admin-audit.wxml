<view class="container">
  <view class="hero">
    <view class="hero-title">管理端综合质审台</view>
    <view class="hero-sub">学信网核验 · 试讲量规 · 电子工牌</view>
  </view>

  <view class="stats card row-between">
    <view class="stat"><view class="n">{{pendingCount}}</view><view class="muted">待初审</view></view>
    <view class="stat"><view class="n">{{approvedCount}}</view><view class="muted">已入库</view></view>
    <view class="stat"><view class="n">{{totalCount}}</view><view class="muted">全部案卷</view></view>
  </view>

  <view class="filter-row">
    <view class="ftab {{filter==='all'?'on':''}}" data-f="all" bindtap="setFilter">全部</view>
    <view class="ftab {{filter==='pending'?'on':''}}" data-f="pending" bindtap="setFilter">待初审</view>
    <view class="ftab {{filter==='approved'?'on':''}}" data-f="approved" bindtap="setFilter">已入库</view>
    <view class="ftab {{filter==='rejected'?'on':''}}" data-f="rejected" bindtap="setFilter">已否决</view>
    <view class="ftab {{filter==='supplement'?'on':''}}" data-f="supplement" bindtap="setFilter">需补件</view>
  </view>

  <view class="field">
    <input class="input" placeholder="搜索姓名 / 编号 / 手机尾号 / 高校" placeholder-class="input-placeholder" value="{{keyword}}" bindinput="onSearch" />
  </view>

  <view class="card mentor-row {{selectedId===item.id?'sel':''}}" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="selectItem">
    <view class="row-between">
      <view class="flex-row gap-8">
        <view class="avatar">{{item.surname}}</view>
        <view>
          <view class="name">{{item.realName}} <text class="badge badge-{{item.status}}">{{item.statusLabel}}</text></view>
          <view class="muted">{{item.code}} · {{item.university}}</view>
        </view>
      </view>
      <view class="phone-tail">尾号 {{item.phoneLast4}}</view>
    </view>
    <view class="muted" style="margin-top:8rpx;">{{item.subjectsText}} · ¥{{item.hourlyRate}}/h</view>
  </view>

  <view class="card" wx:if="{{current}}">
    <view class="card-title">案卷详情 · {{current.id}}</view>
    <view class="detail-line">手机：{{current.phone}}（尾号 {{current.phoneLast4}}）</view>
    <view class="detail-line">身份证：{{current.idCard}}</view>
    <view class="detail-line">学信网：{{current.chsiCode}} · {{current.chsiStatus}}</view>
    <view class="detail-line">专业：{{current.chsiMajor}}</view>
    <view class="detail-line">亮点：{{current.scoreHighlight}}</view>
    <view class="detail-line">试讲：{{current.lectureUrl}}</view>
    <view class="detail-line">评级：{{current.evalGrade}}</view>
    <view class="detail-line">意见：{{current.reviewComment || '暂无'}}</view>

    <view class="field" style="margin-top:20rpx;">
      <text class="label">审核意见</text>
      <textarea class="input" style="min-height:120rpx;" placeholder="填写核准/驳回原因" placeholder-class="input-placeholder" value="{{reviewComment}}" bindinput="onComment" />
    </view>
    <view class="field">
      <text class="label">教研定级</text>
      <picker mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="onGrade">
        <view class="input">{{grades[gradeIndex]}}</view>
      </picker>
    </view>

    <view class="flex-row gap-8" wx:if="{{current.status==='pending' || current.status==='supplement'}}">
      <button class="btn-danger" style="flex:1;" bindtap="onReject">否决驳回</button>
      <button class="btn-ghost" style="flex:1;" bindtap="onSupplement">打回补件</button>
      <button class="btn-primary" style="flex:2;" bindtap="onApprove">核准入库</button>
    </view>
  </view>

  <button class="btn-ghost" style="width:100%;" bindtap="goLogin">返回登录</button>
  <button class="btn-ghost" style="width:100%;margin-top:12rpx;" bindtap="resetDemo">重置演示数据</button>
</view>
