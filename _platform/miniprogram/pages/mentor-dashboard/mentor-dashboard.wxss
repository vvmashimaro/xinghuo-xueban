.banner {
  padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 24rpx;
  margin-bottom: 20rpx; border: 1px solid transparent; line-height: 1.5;
}
.banner-ok { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
.banner-warn { background: #fffbeb; border-color: #fde68a; color: #b45309; }
.banner-bad { background: #fff1f2; border-color: #fecdd3; color: #be123c; }
.detail-line { font-size: 24rpx; color: #475569; margin-top: 8rpx; word-break: break-all; }
.inbox-row {
  margin-top: 14rpx; padding: 18rpx; background: #f8fafc;
  border-radius: 14rpx; border: 1px solid #e2e8f0;
}
