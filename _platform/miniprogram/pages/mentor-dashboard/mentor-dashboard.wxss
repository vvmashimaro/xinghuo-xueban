.banner {
  padding: 20rpx 24rpx; border-radius: 16rpx; font-size: 24rpx;
  margin-bottom: 20rpx; border: 1px solid transparent; line-height: 1.5;
}
.banner-ok { background: #ecfdf5; border-color: #a7f3d0; color: #047857; }
.banner-warn { background: #fffbeb; border-color: #fde68a; color: #b45309; }
.banner-bad { background: #fff1f2; border-color: #fecdd3; color: #be123c; }
.detail-line { font-size: 24rpx; color: #475569; margin-top: 8rpx; word-break: break-all; }
.inbox-row {
  margin-top: 14rpx; padding: 18rpx; background: #f8fafc;
  border-radius: 14rpx; border: 1px solid #e2e8f0;
}

.avail-picker {
  border: 1px solid #ccfbf1;
  background: #f0fdfa;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}

.avail-picker-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.avail-step {
  font-size: 22rpx;
  font-weight: 700;
  color: #0f766e;
}

.avail-weekday-btn {
  font-size: 24rpx;
  font-weight: 700;
  color: #14b8a6;
  background: white;
  border: 1px solid #5eead4;
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
}

.avail-clear {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748b;
  background: white;
  border: 1px solid #e2e8f0;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.avail-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.avail-slot {
  font-size: 20rpx;
  font-family: Menlo, Monaco, Consolas, monospace;
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 10rpx;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #64748b;
  transition: all 0.15s ease;
}

.avail-slot-on {
  background: #14b8a6;
  border-color: #0d9488;
  color: white;
  font-weight: 700;
}

.avail-summary {
  font-size: 20rpx;
  color: #0f766e;
  background: white;
  border: 1px solid #99f6e4;
  border-radius: 10rpx;
  padding: 10rpx 12rpx;
  line-height: 1.6;
}

picker {
  position: relative;
  z-index: 10;
}
