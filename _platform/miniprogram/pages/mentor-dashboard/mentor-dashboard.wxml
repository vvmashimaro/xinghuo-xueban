<view class="shell">
  <view class="shell-glow shell-glow-bl"></view>
  <view class="page-inner" wx:if="{{ready}}">
    <view class="brand-block" style="margin-bottom:24rpx;">
      <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
      <view>
        <view class="brand-name">{{mentorName}}<text class="brand-tag">{{statusLabel}}</text></view>
        <view class="brand-desc">{{university}} · ¥{{hourlyRate}}/时</view>
      </view>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">约课申请箱</view>
      <view wx:for="{{inbox}}" wx:key="id" class="tutor-card" style="padding:0;margin-top:16rpx;">
        <view class="tutor-name">{{item.studentNickname}} · {{item.subject}}</view>
        <view class="muted">{{item.schedule}} · {{item.space}}</view>
        <view class="row-flex" style="margin-top:12rpx;">
          <button class="btn-primary" style="flex:1;" data-id="{{item.id}}" bindtap="accept">接单</button>
          <button class="btn-ghost" style="flex:1;" data-id="{{item.id}}" bindtap="decline">婉拒</button>
        </view>
      </view>
      <view wx:if="{{!inbox.length}}" class="muted" style="text-align:center;padding:24rpx;">暂无待处理约课</view>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">偏好教学网点</view>
      <picker mode="selector" range="{{spaces}}" value="{{spaceIndex}}" bindchange="onSpace">
        <view class="input">{{spaces[spaceIndex]}}</view>
      </picker>
      <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="saveSpace">保存网点偏好</button>
    </view>

    <button class="btn-ghost" style="width:100%;" bindtap="logout">退出登录</button>
  </view>
</view>
