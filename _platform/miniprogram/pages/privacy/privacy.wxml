<view class="shell">
  <view class="page-inner">
    <view class="xh-card">
      <view class="xh-card-title">星火学伴 个人信息保护政策</view>
      <view class="xh-card-sub">与 Web 端 `privacy.html` / `docs/` 口径一致</view>
      <block wx:for="{{sections}}" wx:key="title">
        <view class="section-title">{{item.title}}</view>
        <text wx:for="{{item.lines}}" wx:key="*this" class="privacy-line">{{item}}</text>
      </block>
      <button class="btn-primary" style="width:100%;margin-top:24rpx;" bindtap="goBack">返回</button>
    </view>
  </view>
</view>
