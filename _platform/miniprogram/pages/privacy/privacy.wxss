.privacy-container {
  min-height: 100vh;
  background: #f8fafc;
  padding: 32rpx;
}

.privacy-header {
  background: #0f172a;
  color: #fff;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  text-align: center;
}

.privacy-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.privacy-subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.85;
  margin-bottom: 24rpx;
}

.privacy-operator {
  display: block;
  font-size: 24rpx;
  opacity: 0.7;
}

.privacy-body {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.section {
  margin-bottom: 48rpx;
}

.section:last-child {
  margin-bottom: 0;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #e2e8f0;
}

.section-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.content-line {
  display: block;
  font-size: 28rpx;
  line-height: 1.8;
  color: #475569;
}

.content-line:empty {
  height: 8rpx;
}

.privacy-footer {
  padding: 32rpx 0;
}

.btn-back {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #0f172a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.btn-back::after {
  border: none;
}
