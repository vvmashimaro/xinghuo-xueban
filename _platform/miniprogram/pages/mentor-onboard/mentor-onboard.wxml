<view class="shell">
  <view class="shell-glow shell-glow-tr"></view>
  <view class="page-inner">
    <view class="brand-block" style="margin-bottom:24rpx;">
      <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
      <view>
        <view class="brand-name">导师入库<text class="brand-tag">L{{step}}</text></view>
        <view class="brand-desc">学信网核验 · 合规授课 · 阳光接单</view>
      </view>
    </view>

    <view class="step-dots">
      <view class="step-dot {{step>=1?'on':''}}"></view>
      <view class="step-dot {{step>=2?'on':''}}"></view>
    </view>

    <view class="xh-card" wx:if="{{step===1}}">
      <view class="xh-card-title">L1 身份与清算账户</view>
      <view class="field"><text class="label">真实姓名</text><input class="input" value="{{form.realName}}" data-k="realName" bindinput="onField" /></view>
      <view class="field"><text class="label">手机号</text><input class="input" type="number" maxlength="11" value="{{form.phone}}" data-k="phone" bindinput="onField" /></view>
      <view class="field"><text class="label">身份证号</text><input class="input" value="{{form.idCard}}" data-k="idCard" bindinput="onField" /></view>
      <view class="field"><text class="label">高校</text><input class="input" value="{{form.university}}" data-k="university" bindinput="onField" /></view>
      <view class="field"><text class="label">学信网验证码</text><input class="input" value="{{form.chsiCode}}" data-k="chsiCode" bindinput="onField" /></view>
      <view class="field"><text class="label">银行卡号</text><input class="input" value="{{form.bankCard}}" data-k="bankCard" bindinput="onField" /></view>
      <view class="check-row" bindtap="togglePrivacy">
        <view class="check-box {{form.privacy?'on':''}}">{{form.privacy?'✓':''}}</view>
        <text class="muted">同意个人信息保护与法定核查授权</text>
      </view>
      <button class="btn-primary" style="width:100%;" bindtap="goL2">进入 L2 教学能力建档</button>
    </view>

    <view class="xh-card" wx:if="{{step===2}}">
      <view class="xh-card-title">L2 学科与试讲</view>
      <view class="muted" style="margin-bottom:12rpx;">擅长学科（可多选）</view>
      <scroll-view scroll-x class="chip-scroll">
        <view wx:for="{{subjectOptions}}" wx:key="*this" class="chip {{form.subjectsMap[item]?'on':''}}" data-s="{{item}}" bindtap="toggleSubject">{{item}}</view>
      </scroll-view>
      <view class="field"><text class="label">期望时薪（元/时）</text><input class="input" type="number" value="{{form.hourlyRate}}" data-k="hourlyRate" bindinput="onField" /></view>
      <view class="field"><text class="label">试讲链接</text><input class="input" value="{{form.lectureUrl}}" data-k="lectureUrl" bindinput="onField" placeholder="视频或网盘链接" placeholder-class="input-placeholder" /></view>
      <view class="field">
        <text class="label">偏好网点</text>
        <picker mode="selector" range="{{spaces}}" value="{{form.spaceIndex}}" bindchange="onSpace">
          <view class="input">{{spaces[form.spaceIndex]}}</view>
        </picker>
      </view>
      <button class="btn-ghost" style="width:100%;margin-bottom:12rpx;" bindtap="backL1">返回 L1</button>
      <button class="btn-primary" style="width:100%;" bindtap="submit">提交审核</button>
    </view>
  </view>
</view>
