<view class="container">
  <view class="hero">
    <view class="hero-title">导师认证与动态入库</view>
    <view class="hero-sub">L1 资质核验 → L2 能力画像 → 提交待审</view>
  </view>

  <!-- 步骤条 -->
  <view class="steps card">
    <view class="step-item">
      <view class="step-dot {{step>=1?'active':''}} {{step>1?'done':''}}">{{step>1?'✓':'1'}}</view>
      <text class="{{step>=1?'on':''}}">L1 资质核验</text>
    </view>
    <view class="step-line {{step>1?'fill':''}}"></view>
    <view class="step-item">
      <view class="step-dot {{step>=2?'active':''}} {{step>2?'done':''}}">{{step>2?'✓':'2'}}</view>
      <text class="{{step>=2?'on':''}}">L2 能力画像</text>
    </view>
    <view class="step-line {{step>2?'fill':''}}"></view>
    <view class="step-item">
      <view class="step-dot {{step>=3?'active':''}}">{{step>=3?'✓':'3'}}</view>
      <text class="{{step>=3?'on':''}}">提交完成</text>
    </view>
  </view>

  <!-- L1 -->
  <block wx:if="{{step===1}}">
    <view class="card">
      <view class="card-title">L1 基础身份与合规红线核验</view>
      <view class="field">
        <text class="label">真实姓名</text>
        <input class="input" placeholder="例：张若愚（与身份证一致）" placeholder-class="input-placeholder" value="{{form.realName}}" data-k="realName" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" placeholder="例：138****8000" placeholder-class="input-placeholder" value="{{form.phone}}" data-k="phone" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">身份证号</text>
        <input class="input" placeholder="例：510107********1234" placeholder-class="input-placeholder" value="{{form.idCard}}" data-k="idCard" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">就读 / 毕业高校</text>
        <input class="input" placeholder="例：四川大学 / 电子科技大学" placeholder-class="input-placeholder" value="{{form.university}}" data-k="university" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">学历层次</text>
        <picker mode="selector" range="{{degrees}}" value="{{degreeIndex}}" bindchange="onDegree">
          <view class="input">{{form.degree || '请选择学历'}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">学信网在线验证码</text>
        <input class="input" placeholder="例：A98F72KL50198821" placeholder-class="input-placeholder" value="{{form.chsiCode}}" data-k="chsiCode" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">开户银行</text>
        <picker mode="selector" range="{{banks}}" value="{{bankIndex}}" bindchange="onBank">
          <view class="input">{{form.bankName}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">借记卡号（课酬直达）</text>
        <input class="input" type="number" placeholder="例：621483********8000" placeholder-class="input-placeholder" value="{{form.bankCardNumber}}" data-k="bankCardNumber" bindinput="onField" />
      </view>

      <view class="check-row field" bindtap="onToggleNonPublic">
        <view class="check-box {{form.nonPublic?'on':''}}">{{form.nonPublic?'✓':''}}</view>
        <text>本人承诺非公立学校在编/合同聘任教师，不违反「双减」合规红线</text>
      </view>
      <view class="check-row field" bindtap="onTogglePrivacy">
        <view class="check-box {{form.privacy?'on':''}}">{{form.privacy?'✓':''}}</view>
        <text>同意《个人信息保护与法定核查授权条款》，授权学信网/公安三要素核验</text>
      </view>

      <view class="progress-box">
        <view class="row-between">
          <text class="label" style="margin:0;">L1 必填项完成度</text>
          <text class="muted">{{l1Pct}}%</text>
        </view>
        <view class="bar-bg"><view class="bar-fill" style="width:{{l1Pct}}%;"></view></view>
        <view class="checklist">
          <view class="cli {{l1State.realName?'ok':''}}">{{l1State.realName?'✓':'○'}} 真实姓名</view>
          <view class="cli {{l1State.phone?'ok':''}}">{{l1State.phone?'✓':'○'}} 手机号</view>
          <view class="cli {{l1State.idCard?'ok':''}}">{{l1State.idCard?'✓':'○'}} 身份证</view>
          <view class="cli {{l1State.university?'ok':''}}">{{l1State.university?'✓':'○'}} 高校</view>
          <view class="cli {{l1State.chsiCode?'ok':''}}">{{l1State.chsiCode?'✓':'○'}} 学信网码</view>
          <view class="cli {{l1State.bankCard?'ok':''}}">{{l1State.bankCard?'✓':'○'}} 借记卡</view>
          <view class="cli {{l1State.nonPublic?'ok':''}}">{{l1State.nonPublic?'✓':'○'}} 非在编承诺</view>
          <view class="cli {{l1State.privacy?'ok':''}}">{{l1State.privacy?'✓':'○'}} 隐私授权</view>
        </view>
      </view>

      <button class="btn-primary" style="width:100%;margin-top:16rpx;" bindtap="goL2">完成 L1 核验与签约，进入 L2 能力画像</button>
    </view>
  </block>

  <!-- L2 -->
  <block wx:if="{{step===2}}">
    <view class="card">
      <view class="card-title">L2 辅导能力画像与学科标签</view>
      <view class="field">
        <text class="label">擅长学科（可多选）</text>
        <view class="chip-wrap">
          <view wx:for="{{subjectChips}}" wx:key="name" class="chip {{item.on?'chip-on':''}}" data-v="{{item.name}}" bindtap="toggleSubject">{{item.name}}</view>
        </view>
      </view>
      <view class="field">
        <text class="label">成绩亮点</text>
        <input class="input" placeholder="例：高考数学145分 · 竞赛二等奖" placeholder-class="input-placeholder" value="{{form.scoreHighlight}}" data-k="scoreHighlight" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">期望时薪（元/时）</text>
        <input class="input" type="number" placeholder="成都市建议：70-280" placeholder-class="input-placeholder" value="{{form.hourlyRate}}" data-k="hourlyRate" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">教学风格</text>
        <view class="chip-wrap">
          <view wx:for="{{styleChips}}" wx:key="name" class="chip {{item.on?'chip-on':''}}" data-v="{{item.name}}" bindtap="toggleStyle">{{item.name}}</view>
        </view>
      </view>
      <view class="field">
        <text class="label">试讲视频 / 讲义网盘链接</text>
        <input class="input" placeholder="例：https://pan.baidu.com/s/…" placeholder-class="input-placeholder" value="{{form.lectureUrl}}" data-k="lectureUrl" bindinput="onField" />
      </view>
      <view class="field">
        <text class="label">偏好教学网点</text>
        <picker mode="selector" range="{{spaces}}" value="{{spaceIndex}}" bindchange="onSpace">
          <view class="input">{{form.spacePreference}}</view>
        </picker>
      </view>

      <view class="flex-row gap-8">
        <button class="btn-ghost" style="flex:1;" bindtap="backL1">返回 L1</button>
        <button class="btn-primary" style="flex:2;" bindtap="submitApp">提交入库申请</button>
      </view>
    </view>
  </block>

  <!-- 完成 -->
  <block wx:if="{{step===3}}">
    <view class="card" style="text-align:center;">
      <view style="font-size:64rpx;margin-bottom:12rpx;">✓</view>
      <view class="card-title">入库申请已提交</view>
      <view class="muted">案卷编号 {{resCode}} · {{resName}} · {{resUniversity}}</view>
      <view class="muted" style="margin-top:8rpx;">期望时薪 {{resHourly}} · 状态：待初审</view>
      <button class="btn-primary" style="width:100%;margin-top:28rpx;" bindtap="goDashboard">进入导师工作台查看待审状态</button>
      <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="goLogin">返回登录</button>
    </view>
  </block>
</view>
