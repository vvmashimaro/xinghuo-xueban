<view class="shell">
  <view class="shell-glow shell-glow-tr"></view>
  <view class="shell-glow shell-glow-bl"></view>
  <scroll-view class="page-inner" scroll-y style="height:100vh;" wx:if="{{ready}}">
    <view class="top-bar">
      <view class="brand-block">
        <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
        <view>
          <view class="brand-name">家长主控<text class="brand-tag">MATCH</text></view>
          <view class="brand-desc">{{studentNickname}} · {{gradeBadge}} · {{cityDistrict}}</view>
        </view>
      </view>
      <text class="btn-link" bindtap="goProfile">账户</text>
    </view>

    <view class="hub-row">
      <view class="hub-chip {{hubTab==='match'?'on':''}}" data-tab="match" bindtap="setHub">智能匹配</view>
      <view class="hub-chip {{hubTab==='bookings'?'on':''}}" data-tab="bookings" bindtap="setHub">我的约课</view>
      <view class="hub-chip" bindtap="goEdit">学员画像</view>
    </view>

    <view class="engine-pill">星火算力匹配 · {{matchHint}}</view>

    <block wx:if="{{hubTab==='match'}}">
      <view class="xh-card">
        <input class="input" placeholder="搜索导师 / 学校 / 学科" value="{{keyword}}" bindinput="onKeyword" />
        <scroll-view scroll-x class="chip-scroll" style="margin-top:16rpx;">
          <view wx:for="{{subjectChips}}" wx:key="value" class="chip {{item.on?'on':''}}" data-v="{{item.value}}" bindtap="setSubject">{{item.label}}</view>
        </scroll-view>
        <scroll-view scroll-x class="chip-scroll">
          <view wx:for="{{spaceChips}}" wx:key="value" class="chip {{item.on?'on':''}}" data-v="{{item.value}}" bindtap="setSpace">{{item.label}}</view>
        </scroll-view>
        <picker mode="selector" range="{{sortLabels}}" value="{{sortIndex}}" bindchange="onSort">
          <view class="input" style="margin-top:12rpx;">排序：{{sortLabels[sortIndex]}}</view>
        </picker>
      </view>

      <view wx:for="{{tutors}}" wx:key="mentorId" class="xh-card tutor-card">
        <view class="tutor-head">
          <view class="tutor-avatar">{{item.avatarLetter}}</view>
          <view class="tutor-meta">
            <view class="tutor-name">{{item.maskedName}} <text class="tutor-badge">{{item.tagBadge}}</text></view>
            <view class="muted">{{item.degreeShort}} · ¥{{item.hourlyRate}}/时</view>
            <view class="muted">{{item.syllabusText}}</view>
          </view>
          <view class="match-pct">{{item.matchScore}}%</view>
        </view>
        <button class="btn-primary" style="width:100%;margin-top:16rpx;" data-id="{{item.mentorId}}" bindtap="openBook">预约试课 / 正课</button>
      </view>
      <view wx:if="{{!tutors.length}}" class="muted" style="text-align:center;padding:40rpx;">暂无符合筛选的导师</view>
    </block>

    <block wx:if="{{hubTab==='bookings'}}">
      <scroll-view scroll-x class="chip-scroll">
        <view wx:for="{{bookingTabs}}" wx:key="value" class="chip {{item.on?'on':''}}" data-v="{{item.value}}" bindtap="setBookingTab">{{item.label}}</view>
      </scroll-view>
      <view wx:for="{{bookings}}" wx:key="id" class="xh-card">
        <view style="display:flex;justify-content:space-between;align-items:center;">
          <text style="font-weight:800;">{{item.tutorName}} · {{item.subject}}</text>
          <text class="{{item.statusBadge}}">{{item.statusText}}</text>
        </view>
        <view class="muted" style="margin-top:8rpx;">{{item.schedule}} · {{item.space}}</view>
        <view class="conflict-banner" wx:if="{{item.hasTimeConflict}}">⚠ 时间冲突{{item.timeConflictForced?'（已强制约课）':''}}</view>
      </view>
    </block>
  </scroll-view>

  <view class="modal-mask" wx:if="{{bookShow}}" bindtap="closeBook">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-title">预约 · {{bookTutor.maskedName}}</view>
      <view class="field">
        <text class="label">时段</text>
        <picker mode="selector" range="{{slotLabels}}" bindchange="onSlot">
          <view class="input">{{slotLabels[slotIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">课时（小时）</text>
        <picker mode="selector" range="{{hourOptions}}" value="{{hourIndex}}" bindchange="onHours">
          <view class="input">{{hourOptions[hourIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">教学网点</text>
        <picker mode="selector" range="{{spaces}}" value="{{spaceIndex}}" bindchange="onBookSpace">
          <view class="input">{{spaces[spaceIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">仓位选择</text>
        <scroll-view scroll-x class="chip-scroll">
          <view wx:for="{{boothChips}}" wx:key="id" class="chip {{item.on?'on':''}}" data-id="{{item.id}}" data-label="{{item.label}}" bindtap="setBooth">{{item.label}}</view>
        </scroll-view>
      </view>
      <view class="muted">托管预估 ¥{{escrowAmount}}</view>
      <button class="btn-primary" style="width:100%;margin-top:20rpx;" bindtap="confirmBook">确认约课并托管锁定</button>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{conflictShow}}" bindtap="closeConflict">
    <view class="modal-panel" catchtap="noop">
      <view class="modal-title">时间冲突提醒</view>
      <view class="conflict-banner" style="margin-bottom:20rpx;">{{conflictMsg}}</view>
      <button class="btn-ghost" style="width:100%;margin-bottom:12rpx;" bindtap="closeConflict">返回调整</button>
      <button class="btn-primary" style="width:100%;" bindtap="forceBook">强制约课</button>
    </view>
  </view>
</view>
