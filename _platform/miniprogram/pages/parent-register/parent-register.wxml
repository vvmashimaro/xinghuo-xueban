<view class="shell">
  <view class="shell-glow shell-glow-tr"></view>
  <view class="shell-glow shell-glow-bl"></view>
  <scroll-view class="page-inner" scroll-y style="height:100vh;">
    <view class="brand-block" style="margin-bottom:24rpx;">
      <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
      <view>
        <view class="brand-name">{{pageTitle}}<text class="brand-tag">建档</text></view>
        <view class="brand-desc">{{heroSub}}</view>
      </view>
    </view>

    <view class="xh-card">
      <view class="field">
        <text class="label">家长称呼</text>
        <input class="input" value="{{parentName}}" bindinput="onParentName" placeholder="例：李家长" placeholder-class="input-placeholder" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" maxlength="11" value="{{phone}}" bindinput="onPhone" disabled="{{phoneReadonly}}" placeholder-class="input-placeholder" />
      </view>
      <view class="field">
        <text class="label">学员昵称</text>
        <input class="input" value="{{studentNickname}}" bindinput="onNickname" placeholder="例：乐乐同学" placeholder-class="input-placeholder" />
      </view>
      <view class="field">
        <text class="label">在读年级</text>
        <picker mode="selector" range="{{grades}}" value="{{gradeIndex}}" bindchange="onGrade">
          <view class="input">{{grades[gradeIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">所在区县</text>
        <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrict">
          <view class="input">{{districts[districtIndex]}}</view>
        </picker>
      </view>
      <view class="field">
        <text class="label">偏好上课网点</text>
        <picker mode="selector" range="{{spaces}}" value="{{spaceIndex}}" bindchange="onSpace">
          <view class="input">{{spaces[spaceIndex]}}</view>
        </picker>
      </view>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">目标学科目录</view>
      <view class="xh-card-sub">含考研 / 艺体 / 体育专项 · 与 Web 学科目录一致</view>
      <block wx:for="{{subjectGroups}}" wx:key="title">
        <view class="muted" style="margin:16rpx 0 8rpx;font-weight:800;">{{item.title}}</view>
        <view class="subject-grid">
          <view
            wx:for="{{item.tiles}}"
            wx:for-item="tile"
            wx:key="name"
            class="subject-tile {{tile.on?'on':''}}"
            data-name="{{tile.name}}"
            bindtap="onToggleSubject"
          >
            <view class="subject-tile-name">{{tile.name}}</view>
            <view class="subject-tile-hint">{{tile.hint}}</view>
          </view>
        </view>
      </block>
      <block wx:if="{{subjectTopicSections.length}}">
        <view class="muted" style="margin:24rpx 0 8rpx;font-weight:800;">已选学科 · 关联考点（点选可多选，再次点击取消）</view>
        <block wx:for="{{subjectTopicSections}}" wx:key="subject" wx:for-item="section">
          <view class="topic-section-title">{{section.subject}}</view>
          <view class="chip-wrap">
            <view
              wx:for="{{section.topics}}"
              wx:for-item="topic"
              wx:key="name"
              class="chip {{topic.on?'on':''}}"
              data-subject="{{section.subject}}"
              data-v="{{topic.name}}"
              bindtap="onInlineTopic"
            >{{topic.name}}</view>
          </view>
        </block>
      </block>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">课酬预算（元/时）</view>
      <view class="budget-row">
        <text class="muted">低</text>
        <slider min="70" max="240" step="10" value="{{budgetMin}}" bindchange="onBudgetMin" style="flex:1;" activeColor="#FF5A2D" />
        <text style="font-weight:800;">{{budgetMin}}</text>
      </view>
      <view class="budget-row">
        <text class="muted">高</text>
        <slider min="70" max="240" step="10" value="{{budgetMax}}" bindchange="onBudgetMax" style="flex:1;" activeColor="#FF5A2D" />
        <text style="font-weight:800;">{{budgetMax}}</text>
      </view>
      <view class="field" style="margin-top:16rpx;">
        <text class="label">升学 / 备考目标（选填）</text>
        <input class="input" value="{{targetGoal}}" bindinput="onGoal" placeholder="例：中考冲刺 / 考研英语70+" placeholder-class="input-placeholder" />
      </view>
    </view>

    <view class="xh-card">
      <view class="check-row" bindtap="onToggleConsent">
        <view class="check-box {{consent?'on':''}}">{{consent?'✓':''}}</view>
        <text class="muted">我已阅读并同意《资金托管与服务协议》</text>
      </view>
      <button class="btn-primary" style="width:100%;" bindtap="onSubmit">{{submitLabel}}</button>
      <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="goLogin">{{editMode?'返回主控':'返回登录'}}</button>
    </view>
  </scroll-view>

</view>
