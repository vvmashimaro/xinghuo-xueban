.chip-wrap { 
  display: flex; 
  flex-wrap: wrap; 
  position: relative;
  z-index: auto;
}
.empty-hint {
  padding: 24rpx; text-align: center; font-size: 22rpx; color: #94a3b8;
  border: 1px dashed #cbd5e1; border-radius: 16rpx; background: #fff;
}
.plan-chip {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 20rpx; background: #fff; border: 1px solid #e2e8f0; border-radius: 16rpx; margin-top: 12rpx;
}
.budget-display { font-size: 40rpx; font-weight: 900; color: #0f766e; margin-bottom: 8rpx; }
.slider-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.slider-row .val { width: 64rpx; text-align: right; font-weight: 700; color: #0f766e; font-size: 24rpx; }
.link { color: #0f766e; text-decoration: underline; font-weight: 600; }
.wiz-dots { display: flex; align-items: center; gap: 10rpx; margin-bottom: 24rpx; flex-wrap: wrap; }
.wd {
  width: 40rpx; height: 40rpx; border-radius: 50%; background: #e2e8f0; color: #64748b;
  display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800;
}
.wd.active { background: #0d9488; color: #fff; }
.wd.done { background: #ccfbf1; color: #0f766e; }
.pace-row {
  display: flex; align-items: center; gap: 12rpx;
  padding: 16rpx; border: 1px solid #e2e8f0; border-radius: 14rpx; margin-bottom: 12rpx;
  font-size: 24rpx;
  min-height: 72rpx;
  cursor: pointer;
}
.pace-row radio {
  margin-right: 8rpx;
}
.agr-h { font-weight: 800; color: #0f172a; margin: 16rpx 0 6rpx; font-size: 24rpx; }
.agr-p { font-size: 22rpx; color: #475569; line-height: 1.6; }
.agr-tip {
  margin-top: 20rpx; padding: 16rpx; background: #f0fdfa; border: 1px solid #99f6e4;
  border-radius: 14rpx; font-size: 22rpx; color: #134e4a; line-height: 1.55;
}

.input-readonly {
  background: #f1f5f9;
  color: #64748b;
}

.phone-authorized {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: #f0fdfa;
  border: 2rpx solid #5eead4;
  border-radius: 12rpx;
}

.success-icon {
  width: 48rpx;
  height: 48rpx;
  background: #0d9488;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.phone-display {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

