.budget-row { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.topic-section-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--xh-primary-deep);
  margin: 16rpx 0 10rpx;
}
.chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.chip-wrap .chip {
  margin-right: 0;
  white-space: normal;
  max-width: 100%;
  line-height: 1.35;
}
