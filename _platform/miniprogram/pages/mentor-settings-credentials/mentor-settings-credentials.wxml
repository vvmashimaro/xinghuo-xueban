<view class="container">
  <view class="card">
    <view class="card-title">学信网 / 学籍核验状态</view>
    <view class="detail-line">验证码：<text style="font-family:monospace;">{{chsiMasked}}</text></view>
    <view class="detail-line">学籍状态：{{chsiStatus}}</view>
    <view class="detail-line">专业摘要：{{chsiMajor}}</view>
    <view class="detail-line">佐证材料：{{proofCount}} 项</view>
    <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="openChsiArchive">去学信网更新验证码</button>
  </view>

  <view class="card">
    <view class="card-title">其它证明（选填）</view>
    <view class="muted" style="margin-bottom:12rpx;">学生证、学历证、在校成绩单等，可补充学籍核验</view>
    <button class="btn-ghost" style="width:100%;" bindtap="chooseOtherProof">上传其它证明</button>
    <view wx:if="{{proofFiles.length}}" style="margin-top:12rpx;">
      <view class="detail-line" wx:for="{{proofFiles}}" wx:key="id" wx:for-index="idx">
        {{item.name}} · {{item.size}}
        <text style="color:#ef4444;margin-left:8rpx;" data-idx="{{idx}}" bindtap="removeProof">移除</text>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">敏感信息（只读）</view>
    <view class="muted" style="margin-bottom:12rpx;">变更姓名、身份证、学信网验证码或银行卡将回退为「待审核」。</view>
    <view class="detail-line">姓名：{{realName}}</view>
    <view class="detail-line">手机：{{phone}}</view>
    <view class="detail-line">身份证：{{idCardMasked}}</view>
    <view class="detail-line">开户行：{{bankName}}</view>
    <view class="detail-line">银行卡：{{bankMasked}}</view>
    <button class="btn-primary" style="width:100%;margin-top:16rpx;" bindtap="openSensitive">申请变更敏感信息</button>
  </view>

  <view class="card">
    <view class="card-title">合规承诺</view>
    <view class="detail-line">非在编公立教师承诺：{{publicTeacherCompliance ? '已确认' : '待确认'}}</view>
    <button class="btn-ghost" style="width:100%;margin-top:12rpx;" bindtap="goPrivacy">查看个人信息保护政策</button>
  </view>
</view>

<view class="modal-mask" wx:if="{{sensitiveShow}}">
  <view class="modal-panel">
    <view class="modal-head">
      <view style="font-weight:900;">申请变更敏感信息</view>
      <view style="font-size:20rpx;color:#99f6e4;">与 Web 导师工作台字段一致</view>
    </view>
    <scroll-view scroll-y class="modal-body" style="max-height:55vh;">
      <view class="field">
        <text class="label">拟变更姓名</text>
        <input class="input" value="{{sens.realName}}" data-k="realName" bindinput="onSens" />
      </view>
      <view class="field">
        <text class="label">拟变更身份证号</text>
        <input class="input" maxlength="18" value="{{sens.idCard}}" data-k="idCard" bindinput="onSens" />
      </view>
      <view class="field">
        <text class="label">拟变更学信网验证码（选填）</text>
        <input class="input" maxlength="16" placeholder="例：A98F72KL50198821，留空表示暂不更新" value="{{sens.chsiCode}}" data-k="chsiCode" bindinput="onSens" />
        <view class="chsi-actions" style="margin-top:12rpx;">
          <button class="btn-ghost" size="mini" bindtap="openChsiArchive">去学信网查验证码</button>
        </view>
      </view>
      <view class="field">
        <text class="label">开户银行</text>
        <input class="input" value="{{sens.bankName}}" data-k="bankName" bindinput="onSens" />
      </view>
      <view class="field">
        <text class="label">新银行卡号</text>
        <input class="input" type="number" value="{{sens.bankCardNumber}}" data-k="bankCardNumber" bindinput="onSens" />
      </view>
      <view class="field">
        <text class="label">新手机号</text>
        <input class="input" type="number" maxlength="11" value="{{sens.phone}}" data-k="phone" bindinput="onSens" />
      </view>
      <view class="field">
        <text class="label">变更说明</text>
        <textarea class="input" style="min-height:100rpx;" placeholder="说明变更原因" value="{{sens.note}}" data-k="note" bindinput="onSens" />
      </view>
    </scroll-view>
    <view class="modal-foot">
      <button class="btn-ghost" bindtap="closeSensitive">取消</button>
      <button class="btn-primary" bindtap="submitSensitive">提交并进入复审</button>
    </view>
  </view>
</view>
