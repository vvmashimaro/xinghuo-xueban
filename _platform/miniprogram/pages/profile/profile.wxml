<view class="shell">
  <view class="page-inner">
    <view class="brand-block" style="margin-bottom:24rpx;">
      <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
      <view>
        <view class="brand-name">账户中心<text class="brand-tag">ME</text></view>
        <view class="brand-desc">{{roleLabel}} · {{phoneMasked}}</view>
      </view>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">手机号</view>
      <view class="muted">{{phoneMasked || '未绑定'}}</view>
      <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="unbind" wx:if="{{phoneMasked}}">解绑手机号</button>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">安全</view>
      <button class="btn-ghost" style="width:100%;margin-bottom:12rpx;" bindtap="logout">退出登录</button>
      <button class="btn-ghost" style="width:100%;color:#9f1239;border-color:#fda4af;" bindtap="cancel">注销账户</button>
    </view>
  </view>
</view>
