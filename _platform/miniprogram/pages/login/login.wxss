.role-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.role-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 8rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1px solid #e2e8f0;
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
}
.role-tab.on {
  background: #f0fdfa;
  border-color: #14b8a6;
  color: #0f766e;
}
.link {
  color: #0f766e;
  text-decoration: underline;
  font-weight: 600;
}
.fallback {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 16rpx;
}
.login-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 20rpx;
}
.login-divider-line {
  flex: 1;
  height: 1px;
  background: #e2e8f0;
}
.login-divider-text {
  font-size: 22rpx;
  color: #94a3b8;
}
.btn-wechat-phone {
  width: 100%;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  line-height: 1.4;
}
.btn-wechat-phone[disabled] {
  opacity: 0.65;
}
.wechat-phone-hint {
  text-align: center;
  font-size: 22rpx;
  margin-top: 12rpx;
}
.auto-enter-hint {
  text-align: center;
  margin-top: 20rpx;
}
