<view class="shell login-main">
  <view class="shell-glow shell-glow-tr"></view>
  <view class="shell-glow shell-glow-bl"></view>
  <view class="page-inner">
    <view class="top-bar">
      <view class="brand-block">
        <image class="brand-logo" src="/images/logo-xinghuo.jpg" mode="aspectFill" />
        <view>
          <view class="brand-name">星火学伴<text class="brand-tag">AUTH</text></view>
          <view class="brand-desc">阳光合规课辅 · 智能匹配约课</view>
        </view>
      </view>
      <view class="role-segment">
        <view class="role-pill {{role==='parent'?'on':''}}" data-role="parent" bindtap="onRole">家长</view>
        <view class="role-pill {{role==='mentor'?'on':''}}" data-role="mentor" bindtap="onRole">导师</view>
      </view>
    </view>

    <view class="xh-card">
      <view class="xh-card-title">{{roleTitle}}</view>
      <view class="xh-card-sub">{{roleSubtitle}}</view>

      <view class="field">
        <text class="label">手机号码</text>
        <input class="input" type="number" maxlength="11" placeholder="例：138****8000" placeholder-class="input-placeholder" value="{{mobile}}" bindinput="onMobile" />
      </view>

      <view class="field">
        <text class="label">短信验证码</text>
        <view class="row-flex">
          <input class="input" type="number" maxlength="6" placeholder="6 位验证码" placeholder-class="input-placeholder" value="{{smsCode}}" bindinput="onSms" />
          <button class="btn-ghost" bindtap="onSendSms" disabled="{{smsCooldown>0}}">{{smsCooldown>0?smsCooldown+'s':'获取验证码'}}</button>
        </view>
      </view>

      <view class="check-row" bindtap="onToggleAgree">
        <view class="check-box {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
        <text class="muted">我已阅读并同意
          <text class="btn-link" catchtap="onPrivacy">《隐私政策》</text>
          与平台服务协议
        </text>
      </view>

      <button class="btn-primary" style="width:100%;margin-top:12rpx;" bindtap="onSubmit" loading="{{submitting}}" disabled="{{submitting}}">安全登录</button>

      <view wx:if="{{role==='parent'}}" class="muted" style="text-align:center;margin-top:20rpx;">
        还没有账号？<text class="btn-link" bindtap="goRegister">立即注册建档</text>
      </view>
    </view>

    <view class="xh-card" wx:if="{{role==='mentor'}}">
      <view class="muted">新导师可先完成 L1/L2 认证建库</view>
      <button class="btn-ghost" style="width:100%;margin-top:16rpx;" bindtap="goOnboard">进入导师认证与建库</button>
    </view>

  </view>
</view>
