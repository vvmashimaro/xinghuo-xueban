<view class="container">
  <view class="hero">
    <view class="hero-title">星火学伴</view>
    <view class="hero-sub">{{heroSub}}</view>
  </view>

  <view class="role-tabs">
    <view class="role-tab {{role==='mentor'?'on':''}}" data-role="mentor" bindtap="onSwitchRole">伴读导师</view>
    <view class="role-tab {{role==='parent'?'on':''}}" data-role="parent" bindtap="onSwitchRole">家长 / 学员</view>
  </view>

  <view class="card">
    <view class="card-title">{{roleTitle}}</view>
    <view class="muted" style="margin-bottom:24rpx;">{{roleSubtitle}}</view>

    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="例：138****8000" placeholder-class="input-placeholder" value="{{mobile}}" bindinput="onMobile" />
    </view>

    <view class="field" wx:if="{{role!=='admin'}}">
      <text class="label">短信验证码</text>
      <view class="flex-row gap-8">
        <input class="input" style="flex:1;" type="number" maxlength="6" placeholder="请输入 6 位验证码" placeholder-class="input-placeholder" value="{{smsCode}}" bindinput="onSms" />
        <button class="btn-ghost" style="white-space:nowrap;" bindtap="onSendSms" disabled="{{smsCooldown>0}}">{{smsCooldown>0 ? smsCooldown+'s' : '获取验证码'}}</button>
      </view>
    </view>

    <view class="check-row field" wx:if="{{role!=='admin'}}" bindtap="onToggleAgree">
      <view class="check-box {{agreed?'on':''}}">{{agreed?'✓':''}}</view>
      <text>我已阅读并同意
        <text class="link" catchtap="onShowProtocol">《服务协议》</text>
        与
        <text class="link" catchtap="onShowPrivacy">《隐私政策》</text>
      </text>
    </view>

    <button class="btn-primary" style="width:100%;" bindtap="onSubmit" loading="{{submitting && !autoEntering}}" disabled="{{submitting}}">
      安全登录
    </button>

    <view class="login-divider">
      <view class="login-divider-line"></view>
      <text class="login-divider-text">或</text>
      <view class="login-divider-line"></view>
    </view>

    <button class="btn-wechat-phone"
            open-type="getPhoneNumber"
            bindgetphonenumber="onWechatPhoneLogin"
            loading="{{submitting && !autoEntering}}"
            disabled="{{submitting}}">
      本机号快捷登录（微信授权）
    </button>
    <view class="muted wechat-phone-hint">使用当前微信绑定手机号登录，无需短信验证码</view>

    <view class="auto-enter-hint" wx:if="{{autoEntering}}">
      <text class="muted">正在验证登录状态…</text>
    </view>

    <view class="fallback" wx:if="{{showFallback}}">
      <view class="muted" style="margin-bottom:12rpx;">自动跳转未完成，请手动进入：</view>
      <button class="btn-ghost" style="width:100%;" bindtap="onManualEnter">手动进入 → {{fallbackTitle}}</button>
    </view>

    <view class="muted" wx:if="{{role==='parent'}}" style="text-align:center;margin-top:16rpx;">
      还没有账号？
      <text class="link" style="font-weight:700;" bindtap="goRegister">立即注册</text>
    </view>
  </view>

  <view class="card" wx:if="{{role==='mentor'}}">
    <view class="muted">新导师可直接进入认证建库（无需先登录）</view>
    <button class="btn-ghost" style="margin-top:16rpx;width:100%;" bindtap="goOnboard">进入导师认证与建库 (L1/L2)</button>
  </view>

</view>
<xh-loading show="{{xhLoadingShow}}"></xh-loading>
