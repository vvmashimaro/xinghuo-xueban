/* 星火伴学 · Style C 全局设计令牌 */
page {
  --color-primary-deep: #e83a1f;
  --color-primary: #ff5a2d;
  --color-primary-mid: #ff8a3d;
  --color-primary-light: #ffc14d;
  --color-blush: #ffc0cb;
  --color-cream: #fff8f0;
  --color-grad-peach: #ffe4d6;
  --color-grad-lavender: #ede4ff;
  --color-slate-900: #0f172a;
  --color-slate-800: #1e293b;
  --color-slate-500: #64748b;
  --color-surface: #fff8f0;
  --color-surface-2: #ffe4d6;
  --color-success: #4ade80;
  --color-warning: #facc15;
  --color-danger: #fda4af;
  --color-info: #c4b5fd;
  background: linear-gradient(
    165deg,
    var(--color-grad-peach) 0%,
    var(--color-cream) 45%,
    var(--color-grad-lavender) 100%
  );
  color: var(--color-slate-800);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  height: 100%;
  overflow-y: auto;
}

view, text, button, input, textarea, picker, label, scroll-view {
  box-sizing: border-box;
}

.brand-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}
.brand-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 45, 0.2);
}
.brand-title {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--color-slate-900);
}
.brand-sub {
  font-size: 22rpx;
  color: var(--color-slate-500);
  margin-top: 6rpx;
}

.container {
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
}

.card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 28rpx;
  border: 1px solid rgba(255, 192, 203, 0.35);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 28rpx rgba(255, 90, 45, 0.08);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-slate-900);
  margin-bottom: 8rpx;
}

.muted {
  color: var(--color-slate-500);
  font-size: 22rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 22rpx;
  font-weight: 700;
  font-size: 28rpx;
  padding: 22rpx 32rpx;
  border: none;
  line-height: 1.4;
  box-shadow: 0 6rpx 16rpx rgba(255, 90, 45, 0.25);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #ffc0cb;
  color: #fff;
  box-shadow: none;
}

.btn-ghost {
  background: #fff8f0;
  color: var(--color-primary-deep);
  border: 1px solid var(--color-blush);
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
  line-height: 1.3;
}
.btn-ghost::after { border: none; }

.btn-danger {
  background: #fff1f2;
  color: #9f1239;
  border: 1px solid var(--color-danger);
  border-radius: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
}
.btn-danger::after { border: none; }

.input {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  line-height: 1.45;
  background: #fff;
  border: 1px solid #e2e8f0;
  border-radius: 18rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-slate-800);
  overflow: visible;
  box-sizing: border-box;
  position: relative;
  z-index: auto;
}
view.input {
  display: flex;
  align-items: center;
}
picker {
  display: block;
  width: 100%;
  position: relative;
  z-index: 10;
}
textarea.input,
textarea {
  min-height: 160rpx;
  line-height: 1.5;
  display: block;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.input-placeholder {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-slate-800);
  margin-bottom: 10rpx;
  display: block;
}

.field { margin-bottom: 24rpx; }

.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1px solid transparent;
}
.badge-pending { background: #fef9c3; color: #854d0e; border-color: var(--color-warning); }
.badge-approved { background: #dcfce7; color: #166534; border-color: var(--color-success); }
.badge-rejected { background: #fff1f2; color: #9f1239; border-color: var(--color-danger); }
.badge-supplement { background: #ede9fe; color: #5b21b6; border-color: var(--color-info); }
.badge-teal,
.badge-brand {
  background: #fff8f0;
  color: var(--color-primary-deep);
  border-color: var(--color-blush);
}

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #475569;
  font-size: 22rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip-on {
  background: #fff8f0;
  border-color: var(--color-primary-mid);
  color: var(--color-primary-deep);
  font-weight: 700;
}

.hero {
  background: linear-gradient(135deg, #fff8f0 0%, #ffe4d6 55%, #ede4ff 100%);
  color: var(--color-slate-900);
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(255, 192, 203, 0.4);
  box-shadow: 0 8rpx 24rpx rgba(255, 90, 45, 0.1);
}
.hero-title { font-size: 36rpx; font-weight: 900; }
.hero-sub { font-size: 22rpx; color: var(--color-slate-500); margin-top: 8rpx; }

.banner-warning {
  background: #fef9c3;
  border: 1px solid var(--color-warning);
  color: #713f12;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}
.banner-error {
  background: #fff1f2;
  border: 1px solid var(--color-danger);
  color: #9f1239;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-row { display: flex; align-items: center; }
.gap-8 { gap: 16rpx; }

.section-h {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-slate-900);
  margin-bottom: 16rpx;
}

.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal-panel {
  background: #fff;
  border-radius: 32rpx;
  width: 100%;
  max-height: 88vh;
  overflow: visible;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1001;
  border: 1px solid rgba(255, 192, 203, 0.35);
}
.modal-head {
  padding: 28rpx 32rpx;
  background: linear-gradient(90deg, #ff8a3d, #ff5a2d);
  color: #fff;
  flex-shrink: 0;
  border-radius: 32rpx 32rpx 0 0;
}
.modal-body {
  padding: 28rpx 32rpx;
  overflow-y: auto;
  flex: 1;
  position: relative;
}
.modal-foot {
  padding: 20rpx 32rpx;
  border-top: 1px solid #e2e8f0;
  background: #fff8f0;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1.5;
  padding: 8rpx;
  min-height: 56rpx;
  cursor: pointer;
}
.check-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 10rpx;
  border: 2rpx solid #94a3b8;
  flex-shrink: 0;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  position: relative;
}
.check-box::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
}
.check-box.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}

.hub-badge {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 800;
  font-family: Menlo, Monaco, Consolas, monospace;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 90, 45, 0.12);
  color: var(--color-primary-deep);
  border: 1px solid rgba(255, 138, 61, 0.45);
  margin-left: 8rpx;
  vertical-align: middle;
}

.grade-pill {
  display: inline-block;
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #f1f5f9;
  color: #475569;
  margin-left: 8rpx;
}

.hero-engine {
  background: linear-gradient(120deg, #0f172a 0%, #1e293b 42%, #431407 100%);
  color: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  border: 1px solid rgba(255, 90, 45, 0.25);
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.2);
  position: relative;
  overflow: hidden;
}
.hero-engine::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 90, 45, 0.15);
  border-radius: 50%;
  filter: blur(20rpx);
}
.engine-pill {
  display: inline-flex;
  align-items: center;
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 90, 45, 0.22);
  color: #fdba74;
  border: 1px solid rgba(251, 146, 60, 0.35);
  margin-bottom: 12rpx;
}
.engine-title {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.35;
  position: relative;
  z-index: 1;
}
.engine-actions {
  margin-top: 16rpx;
  position: relative;
  z-index: 1;
}
.btn-engine {
  background: var(--color-primary);
  color: #fff;
  border-radius: 18rpx;
  font-size: 22rpx;
  font-weight: 800;
  padding: 14rpx 28rpx;
  border: none;
  line-height: 1.3;
  box-shadow: 0 6rpx 16rpx rgba(255, 90, 45, 0.35);
}
.btn-engine::after { border: none; }

.section-label {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-slate-900);
  margin: 20rpx 0 12rpx;
}
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}
.filter-tab {
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 14rpx;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #64748b;
}
.filter-tab.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: #fff;
}

.chip-label-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 8rpx;
}
.chip-label-key {
  flex-shrink: 0;
  width: 128rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #94a3b8;
  padding-top: 8rpx;
}

.conflict-banner {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  font-size: 20rpx;
  line-height: 1.45;
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #92400e;
}

.booth-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 14rpx;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #475569;
  font-size: 22rpx;
  margin: 0 12rpx 12rpx 0;
}
.booth-chip.on {
  background: #fff8f0;
  border-color: var(--color-primary-mid);
  color: var(--color-primary-deep);
  font-weight: 700;
}
.booth-chip.booth-auto.on {
  background: #0f172a;
  border-color: #0f172a;
  color: #fff;
}

.subject-catalog-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.subject-catalog-tile {
  width: calc(33.33% - 8rpx);
  min-width: 180rpx;
  padding: 16rpx 10rpx;
  text-align: center;
  border-radius: 18rpx;
  border: 1px solid #e2e8f0;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.04);
}
.subject-catalog-tile.on {
  background: #fff8f0;
  border-color: var(--color-primary-mid);
}
.subject-catalog-tile .tile-name {
  font-size: 26rpx;
  font-weight: 900;
  color: var(--color-slate-900);
}
.subject-catalog-tile.on .tile-name { color: var(--color-primary-deep); }
.subject-catalog-tile .tile-hint {
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}
.catalog-group-title {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-slate-800);
  margin: 16rpx 0 10rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid var(--color-primary);
}

.panel-soft {
  background: rgba(255, 248, 240, 0.85);
  border: 1px solid rgba(255, 192, 203, 0.45);
  border-radius: 16rpx;
}

.link {
  color: var(--color-primary-deep);
  text-decoration: underline;
  font-weight: 600;
}
