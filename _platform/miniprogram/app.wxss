/* 星火学伴 · Style C — greenfield design system (Web parity) */
page {
  --xh-primary-deep: #e83a1f;
  --xh-primary: #ff5a2d;
  --xh-primary-mid: #ff8a3d;
  --xh-blush: #ffc0cb;
  --xh-cream: #fff8f0;
  --xh-peach: #ffe4d6;
  --xh-lavender: #ede4ff;
  --xh-text: #1e293b;
  --xh-muted: #64748b;
  --xh-shadow: 0 8rpx 28rpx -6rpx rgba(232, 58, 31, 0.12), 0 4rpx 12rpx -4rpx rgba(15, 23, 42, 0.06);
  background: linear-gradient(165deg, var(--xh-peach) 0%, var(--xh-cream) 42%, var(--xh-lavender) 100%);
  color: var(--xh-text);
  font-size: 28rpx;
  line-height: 1.5;
  height: 100%;
  overflow-y: auto;
}

view, text, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

.shell {
  position: relative;
  min-height: 100vh;
  padding-bottom: 48rpx;
}
.shell-glow {
  position: fixed;
  width: 520rpx;
  height: 520rpx;
  border-radius: 50%;
  pointer-events: none;
  z-index: 0;
  filter: blur(80rpx);
}
.shell-glow-tr {
  top: -120rpx;
  right: -120rpx;
  background: rgba(255, 90, 45, 0.18);
}
.shell-glow-bl {
  bottom: -160rpx;
  left: -160rpx;
  background: rgba(196, 181, 253, 0.35);
}
.page-inner {
  position: relative;
  z-index: 1;
  padding: 24rpx 28rpx 40rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.brand-block {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}
.brand-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  box-shadow: var(--xh-shadow);
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  flex-shrink: 0;
}
.brand-name {
  font-size: 32rpx;
  font-weight: 900;
  color: #0f172a;
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.brand-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--xh-primary);
  background: rgba(255, 90, 45, 0.15);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-family: monospace;
}
.brand-desc {
  font-size: 20rpx;
  color: var(--xh-muted);
  margin-top: 4rpx;
}

.role-segment {
  display: flex;
  padding: 6rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 1px solid rgba(255, 192, 203, 0.45);
  box-shadow: var(--xh-shadow);
  flex-shrink: 0;
}
.role-pill {
  padding: 12rpx 20rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--xh-muted);
  border-radius: 999rpx;
}
.role-pill.on {
  background: var(--xh-primary);
  color: #fff;
  box-shadow: 0 4rpx 12rpx rgba(255, 90, 45, 0.35);
}

.xh-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 32rpx;
  border: 1px solid rgba(255, 192, 203, 0.35);
  box-shadow: var(--xh-shadow);
  padding: 32rpx;
  margin-bottom: 24rpx;
}
.xh-card-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.xh-card-sub {
  font-size: 24rpx;
  color: var(--xh-muted);
  margin-bottom: 24rpx;
  line-height: 1.45;
}

.field { margin-bottom: 24rpx; }
.label {
  font-size: 22rpx;
  font-weight: 800;
  color: #334155;
  margin-bottom: 10rpx;
  display: block;
}
.input {
  width: 100%;
  background: rgba(255, 255, 255, 0.88);
  border-radius: 20rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  border: 1px solid rgba(255, 192, 203, 0.25);
}
.input-placeholder { color: #94a3b8; }
.row-flex { display: flex; align-items: center; gap: 16rpx; }
.row-flex .input { flex: 1; }

.btn-primary {
  background: var(--xh-primary);
  color: #fff;
  font-weight: 800;
  font-size: 28rpx;
  border-radius: 22rpx;
  padding: 24rpx 32rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(255, 90, 45, 0.28);
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #ffc0cb;
  box-shadow: none;
}
.btn-ghost {
  background: rgba(255, 248, 240, 0.95);
  color: var(--xh-primary-deep);
  font-weight: 700;
  font-size: 24rpx;
  border-radius: 18rpx;
  padding: 18rpx 28rpx;
  border: 1px solid var(--xh-blush);
}
.btn-ghost::after { border: none; }
.btn-link {
  color: var(--xh-primary);
  font-weight: 700;
  font-size: 24rpx;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx;
  min-height: 56rpx;
}
.check-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--xh-blush);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #fff;
  flex-shrink: 0;
  position: relative;
}
.check-box::after {
  content: '';
  position: absolute;
  inset: -8rpx;
}
.check-box.on {
  background: var(--xh-primary);
  border-color: var(--xh-primary);
}

.hub-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.hub-chip {
  flex: 1;
  min-width: 140rpx;
  text-align: center;
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(255, 192, 203, 0.4);
  font-size: 24rpx;
  font-weight: 800;
  color: #0f172a;
  box-shadow: var(--xh-shadow);
}
.hub-chip.on {
  background: linear-gradient(135deg, var(--xh-primary) 0%, var(--xh-primary-mid) 100%);
  color: #fff;
  border-color: transparent;
}

.chip-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(255, 192, 203, 0.35);
  color: var(--xh-muted);
}
.chip.on {
  background: rgba(255, 90, 45, 0.12);
  color: var(--xh-primary-deep);
  border-color: var(--xh-primary);
}

.engine-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--xh-primary-deep);
  background: linear-gradient(90deg, rgba(255, 228, 214, 0.9), rgba(237, 228, 255, 0.9));
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
  border: 1px solid rgba(255, 192, 203, 0.3);
}

.tutor-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.tutor-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
}
.tutor-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, var(--xh-peach), var(--xh-lavender));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  font-size: 32rpx;
  color: var(--xh-primary-deep);
}
.tutor-meta { flex: 1; min-width: 0; }
.tutor-name { font-size: 30rpx; font-weight: 900; }
.tutor-badge {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--xh-primary);
  background: rgba(255, 90, 45, 0.1);
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
}
.match-pct {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--xh-primary);
}
.muted { color: var(--xh-muted); font-size: 22rpx; }

.conflict-banner {
  margin-top: 12rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #fef9c3;
  border: 1px solid #facc15;
  color: #713f12;
  font-size: 22rpx;
  font-weight: 700;
}

.subject-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.subject-tile {
  width: calc(50% - 8rpx);
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 192, 203, 0.3);
}
.subject-tile.on {
  border-color: var(--xh-primary);
  background: rgba(255, 90, 45, 0.08);
}
.subject-tile-name { font-weight: 800; font-size: 26rpx; }
.subject-tile-hint { font-size: 20rpx; color: var(--xh-muted); margin-top: 6rpx; }

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.modal-panel {
  width: 100%;
  max-height: 88vh;
  background: var(--xh-cream);
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx 28rpx 48rpx;
  overflow: visible;
  z-index: 1001;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 900;
  margin-bottom: 20rpx;
}
picker { position: relative; z-index: 10; }

.badge-pending { color: #b45309; background: #fef3c7; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 20rpx; }
.badge-approved { color: #166534; background: #dcfce7; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 20rpx; }
.badge-rejected { color: #9f1239; background: #ffe4e6; padding: 4rpx 12rpx; border-radius: 8rpx; font-size: 20rpx; }

.step-dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}
.step-dot {
  flex: 1;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(255, 192, 203, 0.4);
}
.step-dot.on { background: var(--xh-primary); }
