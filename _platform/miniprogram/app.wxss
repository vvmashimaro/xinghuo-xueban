/* 星火学伴 · 全局设计令牌 (teal / slate) */
page {
  --color-primary: #0d9488;
  --color-primary-dark: #0f766e;
  --color-slate-900: #0f172a;
  --color-slate-800: #1e293b;
  --color-slate-500: #64748b;
  --color-surface: #f8fafc;
  --color-surface-2: #f1f5f9;
  --color-success: #10b981;
  --color-warning: #f59e0b;
  --color-danger: #ef4444;
  background: var(--color-surface);
  color: var(--color-slate-800);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
  height: 100%;
  overflow-y: auto;
}

view, text, button, input, textarea, picker, label, scroll-view {
  box-sizing: border-box;
}

.container {
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
}

.container-with-fab {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom) + 120rpx);
  padding-top: 24rpx;
}

.match-banner-wrap {
  padding-top: env(safe-area-inset-top);
  background: linear-gradient(180deg, #0f172a 0%, #f8fafc 72%);
}
.match-banner-wrap .hero {
  margin: 16rpx 28rpx 16rpx;
  border-radius: 24rpx;
}
.hero-kicker {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  color: #5eead4;
  border: 1px solid rgba(94, 234, 212, 0.35);
  background: rgba(20, 184, 166, 0.16);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-bottom: 12rpx;
}

.console-tab-bar {
  position: sticky;
  left: 0;
  right: 0;
  top: 0;
  z-index: 800;
  display: flex;
  gap: 12rpx;
  padding: calc(12rpx + env(safe-area-inset-top)) 28rpx 12rpx;
  background: rgba(248, 250, 252, 0.97);
  border-bottom: 1px solid #e2e8f0;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.06);
}
.match-banner-wrap + .console-tab-bar {
  padding-top: 12rpx;
}
.console-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  font-weight: 800;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: #fff;
  color: #475569;
  border: 1px solid #e2e8f0;
}
.console-tab.on {
  background: #0d9488;
  color: #fff;
  border-color: #0d9488;
}
.console-fab-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 970;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.12);
}
.console-fab-sheet-item {
  width: 100%;
  text-align: left;
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
}
.console-fab-sheet-item.on {
  background: #ccfbf1;
  border-color: #14b8a6;
  color: #115e59;
}

/* 右侧悬浮 · 功能 / 设置入口 */
.fab-settings {
  position: fixed;
  right: 28rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 900;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #0f766e, #0d9488);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 900;
  box-shadow: 0 12rpx 32rpx rgba(13, 148, 136, 0.45);
  border: 2px solid rgba(255, 255, 255, 0.35);
}
.fab-settings:active {
  transform: scale(0.96);
  opacity: 0.92;
}

.settings-drawer-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 950;
}
.settings-drawer {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: min(84vw, 560rpx);
  background: #fff;
  z-index: 960;
  padding: calc(24rpx + env(safe-area-inset-top)) 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: -8rpx 0 32rpx rgba(15, 23, 42, 0.12);
  display: flex;
  flex-direction: column;
}
.settings-drawer-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.settings-drawer-title {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--color-slate-900);
}
.settings-section-title {
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
  margin: 20rpx 0 10rpx;
  letter-spacing: 0.04em;
}
.settings-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}
.settings-item:active {
  background: #f0fdfa;
}
.settings-item-arrow {
  color: #94a3b8;
  font-size: 28rpx;
}
.settings-item-muted {
  color: #64748b;
  font-weight: 600;
}

.chsi-row {
  width: 100%;
}
.chsi-row .input {
  width: 100%;
  box-sizing: border-box;
}
.chsi-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.chsi-actions button {
  flex: 1;
  min-width: 200rpx;
}
.chsi-badge {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  border: 1px solid #e2e8f0;
}
.chsi-badge-idle { background: #f1f5f9; color: #64748b; }
.chsi-badge-warn { background: #fffbeb; color: #b45309; border-color: #fde68a; }
.chsi-badge-ok { background: #ecfdf5; color: #047857; border-color: #a7f3d0; }
.chsi-badge-fail { background: #fef2f2; color: #b91c1c; border-color: #fecaca; }
.chsi-panel {
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
  border-radius: 20rpx;
  padding: 20rpx;
  margin-top: 12rpx;
}
.chsi-panel-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  font-size: 22rpx;
}
.chsi-panel-label { color: #64748b; font-size: 20rpx; }
.chsi-panel-val { font-weight: 800; color: #0f172a; }

.proof-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border: 1px solid #99f6e4;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  font-size: 20rpx;
  margin: 6rpx 8rpx 0 0;
  max-width: 100%;
}
.proof-chip-name {
  max-width: 360rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.proof-upload-zone {
  border: 2px dashed #5eead4;
  border-radius: 20rpx;
  padding: 28rpx;
  text-align: center;
  background: #f0fdfa;
  margin-top: 12rpx;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  border: 1px solid #e2e8f0;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--color-slate-900);
  margin-bottom: 8rpx;
}

.muted {
  color: var(--color-slate-500);
  font-size: 22rpx;
}

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 20rpx;
  font-weight: 700;
  font-size: 28rpx;
  padding: 22rpx 32rpx;
  border: none;
  line-height: 1.4;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] {
  background: #99f6e4;
  color: #fff;
}

.btn-ghost {
  background: #f0fdfa;
  color: var(--color-primary-dark);
  border: 1px solid #99f6e4;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
  line-height: 1.3;
}
.btn-ghost::after { border: none; }

.btn-danger {
  background: #fff1f2;
  color: #be123c;
  border: 1px solid #fecdd3;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  padding: 16rpx 24rpx;
}
.btn-danger::after { border: none; }

.input {
  width: 100%;
  min-height: 80rpx;
  height: auto;
  line-height: 1.45;
  background: #fff;
  border: 1px solid #cbd5e1;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--color-slate-800);
  overflow: visible;
  box-sizing: border-box;
  position: relative;
  z-index: auto;
}
/* picker 等用 view.input 时垂直居中 */
view.input {
  display: flex;
  align-items: center;
}
picker {
  display: block;
  width: 100%;
  position: relative;
  z-index: 10;
}
textarea.input,
textarea {
  min-height: 160rpx;
  line-height: 1.5;
  display: block;
  padding-top: 20rpx;
  padding-bottom: 20rpx;
}
.input-placeholder {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-slate-800);
  margin-bottom: 10rpx;
  display: block;
}

.field { margin-bottom: 24rpx; }

.badge {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  border: 1px solid transparent;
}
.badge-pending { background: #fef3c7; color: #b45309; border-color: #fde68a; }
.badge-approved { background: #d1fae5; color: #047857; border-color: #a7f3d0; }
.badge-rejected { background: #fee2e2; color: #b91c1c; border-color: #fecaca; }
.badge-supplement { background: #e0e7ff; color: #4338ca; border-color: #c7d2fe; }
.badge-teal { background: #f0fdfa; color: #0f766e; border-color: #99f6e4; }

.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
  border: 1px solid #e2e8f0;
  background: #f8fafc;
  color: #475569;
  font-size: 22rpx;
  margin: 0 12rpx 12rpx 0;
}
.chip-on {
  background: #f0fdfa;
  border-color: #5eead4;
  color: #0f766e;
  font-weight: 700;
}

.hero {
  background: linear-gradient(135deg, #0f172a 0%, #134e4a 100%);
  color: #fff;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}
.hero-title { font-size: 36rpx; font-weight: 900; }
.hero-sub { font-size: 22rpx; color: #99f6e4; margin-top: 8rpx; }

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-row { display: flex; align-items: center; }
.gap-8 { gap: 16rpx; }

.section-h {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--color-slate-900);
  margin-bottom: 16rpx;
}

.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.55);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.modal-panel {
  background: #fff;
  border-radius: 28rpx;
  width: 100%;
  max-height: 88vh;
  overflow: visible;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1001;
}
.modal-head {
  padding: 28rpx 32rpx;
  background: linear-gradient(90deg, #0f172a, #134e4a);
  color: #fff;
  flex-shrink: 0;
}
.modal-body {
  padding: 28rpx 32rpx;
  overflow-y: auto;
  flex: 1;
  position: relative;
}
.modal-foot {
  padding: 20rpx 32rpx;
  border-top: 1px solid #e2e8f0;
  background: #f8fafc;
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 22rpx;
  color: #475569;
  line-height: 1.5;
  padding: 8rpx;
  min-height: 56rpx;
  cursor: pointer;
}
.check-box {
  width: 48rpx;
  height: 48rpx;
  border-radius: 8rpx;
  border: 2rpx solid #94a3b8;
  flex-shrink: 0;
  margin-top: 2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  position: relative;
}
.check-box::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
}
.check-box.on {
  background: #0d9488;
  border-color: #0d9488;
  color: #fff;
  font-size: 24rpx;
  font-weight: 800;
}
